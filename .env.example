# Ollama (all models run locally)
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:0.6b
# Cross-encoder rerank runs on the generation model via single-token yes/no logprobs.
# Qwen3-Reranker's community GGUF returns a uniform distribution on Ollama and is unusable.
RERANK_MODEL=qwen3:8b
GEN_MODEL=qwen3:8b
# Run the reranker on a second Ollama process to stop it queueing behind generation.
# Only worth setting once `rag rerank-probe` passes a model that is not the generator.
RERANK_OLLAMA_URL=http://localhost:11434
# Sent with every request so the models stay resident between questions.
OLLAMA_KEEP_ALIVE=30m

# Vector store: "postgres" or "numpy". Falls back to numpy if Postgres is unreachable.
VECTOR_STORE=postgres
POSTGRES_DSN=postgresql://rag:rag@localhost:5433/ragpolicy

# Corpus
POLICY_PATH=policy.md

# Exact-match answer cache (same question string → skip models). off for cold eval timings.
ANSWER_CACHE=on
ANSWER_CACHE_PATH=.cache/answers.sqlite
CASSETTE_DIR=tests/cassettes
# off | record | replay
CASSETTE_MODE=off
